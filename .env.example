# Copiez ce fichier vers .env et renseignez vos propres valeurs.
# NE JAMAIS committer le vrai fichier .env.

# Chaîne de connexion MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Secret utilisé pour signer les tokens JWT (chaîne longue et aléatoire)
JWT_SECRET=change-me-with-a-long-random-string

# Port du serveur
PORT=4000

# URL du backend consommée par le frontend
VITE_API_URL=https://portfolio-v2-nw18.onrender.com
