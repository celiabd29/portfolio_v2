# Copiez ce fichier vers .env et renseignez vos propres valeurs.
# NE JAMAIS committer le vrai fichier .env.

# Chaîne de connexion MongoDB Atlas
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Secret utilisé pour signer les tokens JWT (chaîne longue et aléatoire)
JWT_SECRET=change-me-with-a-long-random-string

# Port du serveur
PORT=4000

# URL du backend consommée par le frontend
VITE_API_URL=https://portfolio-v2-nw18.onrender.com

# Clé API Anthropic pour Bip (l'assistant IA). Jamais committée, jamais exposée côté front.
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# Modèle Claude utilisé par Bip (Haiku = rapide et peu coûteux)
BIP_MODEL=claude-haiku-4-5

# Token d'administration (routes /admin). Chaîne longue et aléatoire.
# Généré par ex. avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Envoyé par le front dans l'en-tête : Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me-with-a-long-random-token

# Origines autorisées par CORS (domaines du front), séparées par des virgules.
ALLOWED_ORIGINS=https://mon-portfolio-2jhd.onrender.com,http://localhost:5173
